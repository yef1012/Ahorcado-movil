{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noImplicitAny": false,
    "noEmit": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "skipLibCheck": true,
    "types": ["react"]
  },
  "include": ["App.js", "index.js", "src/**/*.js"],
  "exclude": ["node_modules", "dist", ".expo"]
}
